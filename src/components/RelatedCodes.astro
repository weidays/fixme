---
// Internal links from every error page to its neighbours: other codes on the
// same brand + equipment, the same code on the sister brand that shares its
// control boards, the full code chart, and the same brand's other equipment.
import type { CollectionEntry } from 'astro:content';
import { BRAND_LABELS, EQUIPMENT_LABELS } from '../config';
import { hubLabel, hubPath } from '../lib/codes';

interface Props {
  entry: CollectionEntry<'errors'>;
  siblings: CollectionEntry<'errors'>[];
  sister: CollectionEntry<'errors'> | null;
  otherEquipment: CollectionEntry<'errors'>[];
  hasHub: boolean;
}

const { entry, siblings, sister, otherEquipment, hasHub } = Astro.props;
const d = entry.data;
const label = hubLabel(d.brand, d.equipment);
---

{(siblings.length > 0 || sister || otherEquipment.length > 0) && (
  <section class="related-codes" aria-labelledby="more-codes">
    <h2 id="more-codes">{siblings.length > 0 ? `More ${label} codes` : `More ${BRAND_LABELS[d.brand]} guides`}</h2>
    {siblings.length > 0 && (
      <ul class="related-list">
        {siblings.map((e) => (
          <li><a href={`/error/${e.id}/`}><strong>{e.data.code}</strong> — {e.data.title.replace(/^[^:]*:\s*/, '')}</a></li>
        ))}
      </ul>
    )}
    {sister && (
      <p>
        Same control board family: <a href={`/error/${sister.id}/`}>{`${BRAND_LABELS[sister.data.brand]} ${sister.data.code}`}</a>
      </p>
    )}
    {hasHub && <p><a href={hubPath(d.brand, d.equipment)}>See all {label} error codes →</a></p>}
    {otherEquipment.length > 0 && (
      <p>
        Other {BRAND_LABELS[d.brand]} equipment:{' '}
        {otherEquipment.map((e, i) => (
          <>{i > 0 && ' · '}<a href={`/error/${e.id}/`}>{`${EQUIPMENT_LABELS[e.data.equipment]} — ${e.data.code}`}</a></>
        ))}
      </p>
    )}
  </section>
)}
